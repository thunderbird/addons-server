# Example environment for infra/tests/smoke_test.py
#
# Copy to .env (do not commit, though) and fill in real values.

AWS_REGION=us-west-2

# TCP connectivity targets
RDS_HOST=
RDS_PORT=3306

REDIS_NEW_HOST=
REDIS_EXISTING_HOST=
REDIS_PORT=6379

RABBITMQ_HOST=
RABBITMQ_PORT=5672

ES_HOST=
ES_PORT=443

# Comma-separated lists
DNS_HOSTNAMES=
REQUIRED_SECRETS=

# NAT egress check
NAT_EGRESS_URL=https://httpbin.org/status/200

